<UserControl x:Class="ProcOpt.Views.Pages.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="720" HorizontalAlignment="Left" Margin="0,0,4,0">

            <!-- 通用 -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="&#xE713;" FontFamily="{StaticResource IconFont}" FontSize="14"
                                   Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="通用" FontSize="15" FontWeight="SemiBold" Margin="10,0,0,0"
                                   FontFamily="{StaticResource DisplayFont}" />
                    </StackPanel>

                    <Border Style="{StaticResource SettingRow}" Padding="0,9">
                        <DockPanel>
                            <CheckBox DockPanel.Dock="Right" Style="{StaticResource SwitchToggle}"
                                      IsChecked="{Binding MinimizeToTray, Mode=TwoWay}" />
                            <StackPanel>
                                <TextBlock Text="关闭时最小化到系统托盘" FontSize="13" />
                                <TextBlock Text="关闭主窗口后程序继续在后台监控，从托盘菜单可退出"
                                           Style="{StaticResource SecondaryText}" FontSize="11.5" Margin="0,3,0,0" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Separator Background="#10FFFFFF" Margin="0,2" />
                    <Border Style="{StaticResource SettingRow}" Padding="0,9">
                        <DockPanel>
                            <CheckBox DockPanel.Dock="Right" Style="{StaticResource SwitchToggle}"
                                      IsChecked="{Binding StartWithWindows, Mode=TwoWay}" />
                            <StackPanel>
                                <TextBlock Text="开机自动启动" FontSize="13" />
                                <TextBlock Text="以计划任务方式在登录时以管理员权限自动启动"
                                           Style="{StaticResource SecondaryText}" FontSize="11.5" Margin="0,3,0,0" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- 自动应用 -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="&#xE8FD;" FontFamily="{StaticResource IconFont}" FontSize="14"
                                   Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="自动应用" FontSize="15" FontWeight="SemiBold" Margin="10,0,0,0"
                                   FontFamily="{StaticResource DisplayFont}" />
                    </StackPanel>

                    <Border Style="{StaticResource SettingRow}" Padding="0,9">
                        <DockPanel>
                            <CheckBox DockPanel.Dock="Right" Style="{StaticResource SwitchToggle}"
                                      IsChecked="{Binding AutoApply, Mode=TwoWay}" />
                            <StackPanel>
                                <TextBlock Text="启用规则自动应用" FontSize="13" />
                                <TextBlock Text="检测到匹配进程启动时自动应用预设设置"
                                           Style="{StaticResource SecondaryText}" FontSize="11.5" Margin="0,3,0,0" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Separator Background="#10FFFFFF" Margin="0,2" />
                    <Border Style="{StaticResource SettingRow}" Padding="0,9">
                        <DockPanel>
                            <ComboBox DockPanel.Dock="Right" Width="96" ItemsSource="{Binding IntervalChoices}"
                                      SelectedItem="{Binding PollIntervalSec, Mode=TwoWay}" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="检测间隔" FontSize="13" />
                                <TextBlock Text="间隔越短应用越及时，占用略高" Style="{StaticResource SecondaryText}"
                                           FontSize="11.5" Margin="0,3,0,0" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Separator Background="#10FFFFFF" Margin="0,2" />
                    <Border Style="{StaticResource SettingRow}" Padding="0,9">
                        <DockPanel>
                            <CheckBox DockPanel.Dock="Right" Style="{StaticResource SwitchToggle}"
                                      IsChecked="{Binding NotifyOnApply, Mode=TwoWay}" />
                            <TextBlock Text="自动应用成功时显示气泡通知" FontSize="13" VerticalAlignment="Center" />
                        </DockPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- 内存清理 -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="&#xE74D;" FontFamily="{StaticResource IconFont}" FontSize="14"
                                   Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="内存清理" FontSize="15" FontWeight="SemiBold" Margin="10,0,0,0"
                                   FontFamily="{StaticResource DisplayFont}" />
                    </StackPanel>

                    <Border Style="{StaticResource SettingRow}" Padding="0,9">
                        <DockPanel>
                            <CheckBox DockPanel.Dock="Right" Style="{StaticResource SwitchToggle}"
                                      IsChecked="{Binding AutoCleanMemory, Mode=TwoWay}" />
                            <StackPanel>
                                <TextBlock Text="内存占用超阈值时自动清理" FontSize="13" />
                                <TextBlock Text="整理全部进程工作集并清空系统备用列表，完成时气泡通知"
                                           Style="{StaticResource SecondaryText}" FontSize="11.5" Margin="0,3,0,0" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Separator Background="#10FFFFFF" Margin="0,2" />
                    <Border Style="{StaticResource SettingRow}" Padding="0,9">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" Margin="12,0,0,0"
                                       FontFamily="{StaticResource MonoFont}" FontSize="12"
                                       Foreground="{StaticResource AccentBrush}"
                                       Text="{Binding AutoCleanThresholdPct, Mode=OneWay, StringFormat=≥{0}%}" />
                            <ComboBox DockPanel.Dock="Right" Width="76"
                                      ItemsSource="{Binding CleanThresholdChoices}"
                                      SelectedItem="{Binding AutoCleanThresholdPct, Mode=TwoWay}" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="触发阈值" FontSize="13" />
                                <TextBlock Text="物理内存占用达到该值时触发清理" Style="{StaticResource SecondaryText}"
                                           FontSize="11.5" Margin="0,3,0,0" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Separator Background="#10FFFFFF" Margin="0,2" />
                    <Border Style="{StaticResource SettingRow}" Padding="0,9">
                        <DockPanel>
                            <ComboBox DockPanel.Dock="Right" Width="96"
                                      ItemsSource="{Binding CleanIntervalChoices}"
                                      SelectedItem="{Binding AutoCleanIntervalMin, Mode=TwoWay}" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="最小清理间隔" FontSize="13" />
                                <TextBlock Text="两次自动清理之间的最短时间，避免频繁清理"
                                           Style="{StaticResource SecondaryText}" FontSize="11.5" Margin="0,3,0,0" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- 关于 & 更新 -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <Border Width="34" Height="34" CornerRadius="9" Background="{StaticResource AccentBrush}">
                            <TextBlock Text="&#xE945;" FontFamily="{StaticResource IconFont}" FontSize="17"
                                       Foreground="#FF151313" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock FontFamily="{StaticResource MonoFont}" FontSize="13" FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimary}"><Run Text="PROC OPT " /><Run Text="{Binding AppVersion, Mode=OneWay}" /></TextBlock>
                            <TextBlock Style="{StaticResource SecondaryText}" FontSize="11">Windows 11 进程调优工具 · 能效模式 · 优先级 · 相关性</TextBlock>
                        </StackPanel>
                    </StackPanel>
                    <Separator Background="#10FFFFFF" Margin="0,0,0,10" />

                    <!-- 更新下载渠道 -->
                    <Border Style="{StaticResource SettingRow}" Padding="0,9">
                        <DockPanel>
                            <ComboBox DockPanel.Dock="Right" Width="200"
                                      ItemsSource="{Binding UpdateProxyChoices}"
                                      SelectedIndex="{Binding UpdateProxyIndex, Mode=TwoWay}" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="更新下载渠道" FontSize="13" />
                                <TextBlock Text="国内访问 GitHub 缓慢或失败时，切换到加速代理"
                                           Style="{StaticResource SecondaryText}" FontSize="11.5" Margin="0,3,0,0" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Separator Background="#10FFFFFF" Margin="0,12,0,10" />

                    <!-- 检查更新 -->
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="UpdateStatusText" Text="{Binding UpdateStatus, Mode=OneWay}"
                                       FontFamily="{StaticResource MonoFont}" FontSize="11"
                                       Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"
                                       Margin="0,0,12,0" />
                            <Button Command="{Binding CheckUpdateCommand}" MinWidth="96">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE895;" FontFamily="{StaticResource IconFont}" FontSize="12"
                                               Margin="0,1,7,0" Foreground="{StaticResource AccentBrush}" />
                                    <TextBlock Text="检查更新" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <TextBlock Style="{StaticResource SecondaryText}" FontSize="11.5" VerticalAlignment="Center"
                                   Text="通过 GitHub Releases 检测并安装新版本" />
                    </DockPanel>

                    <Separator Background="#10FFFFFF" Margin="0,12,0,10" />
                    <TextBlock FontFamily="{StaticResource MonoFont}" FontSize="11.5" LineHeight="22"
                               Foreground="{StaticResource TextSecondary}">
                        <Run Text="{Binding CpuSummary, Mode=OneWay}" /><Line />
                        <Run Text="{Binding RuleCount, Mode=OneWay}" />
                    </TextBlock>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
