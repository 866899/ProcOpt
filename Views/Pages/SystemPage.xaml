<UserControl x:Class="ProcOpt.Views.Pages.SystemPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <!-- 细进度条。注意：必须命名 PART_Track，否则指示条宽度不会更新 -->
        <ControlTemplate x:Key="SlimBar" TargetType="ProgressBar">
            <Grid Height="5">
                <Border x:Name="PART_Track" CornerRadius="2.5" Background="#14FFFFFF" />
                <Border x:Name="PART_Indicator" CornerRadius="2.5" HorizontalAlignment="Left"
                        Background="{StaticResource AccentBrush}" />
            </Grid>
        </ControlTemplate>

        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
        </Style>

        <Style x:Key="TempChip" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
        </Style>

        <Style x:Key="BigNum" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
            <Setter Property="FontSize" Value="24" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
        </Style>

        <Style x:Key="FootText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Foreground" Value="{StaticResource TextFaint}" />
            <Setter Property="Margin" Value="0,7,0,0" />
        </Style>

        <Style x:Key="ChartBox" TargetType="Border">
            <Setter Property="Height" Value="64" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Background" Value="#0AFFFFFF" />
            <Setter Property="Margin" Value="0,10,0,0" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
        </Style>

        <!-- 轻量小按钮（复制报告等） -->
        <Style x:Key="ChipButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="4" Padding="{TemplateBinding Padding}"
                                Background="#14FFFFFF">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#24FFFFFF" />
                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel MaxWidth="1600" HorizontalAlignment="Center">

            <!-- 页头：标题 + 图表窗口切换 -->
            <DockPanel Margin="0,0,0,12">
                <TextBlock Text="系统总览" FontSize="15" FontWeight="SemiBold"
                           FontFamily="{StaticResource DisplayFont}"
                           Foreground="{StaticResource TextPrimary}" DockPanel.Dock="Left"
                           VerticalAlignment="Center" />
                <Button Style="{StaticResource ChipButton}" DockPanel.Dock="Right" HorizontalAlignment="Right"
                        VerticalAlignment="Center" Content="{Binding ChartWindowText, Mode=OneWay}"
                        Click="ChartWindow_Click" />
            </DockPanel>

            <!-- ══════════ 分区 1 · 实时性能 ══════════ -->
            <DockPanel Margin="2,0,0,10">
                <Border Width="3" Height="11" CornerRadius="1.5" Background="{StaticResource AccentBrush}"
                        VerticalAlignment="Center" DockPanel.Dock="Left" />
                <TextBlock Text="实时性能" FontSize="11.5" FontWeight="SemiBold"
                           FontFamily="{StaticResource DisplayFont}" Foreground="{StaticResource TextSecondary}"
                           VerticalAlignment="Center" Margin="8,0,0,0" DockPanel.Dock="Left" />
                <Border Height="1" Background="#16FFFFFF" VerticalAlignment="Center" Margin="12,0,4,0" />
            </DockPanel>

            <!-- 性能四卡：窄屏 2×2 · 宽屏 1×4（随窗口宽度自适应，见 UpdatePerfLayout） -->
            <Grid x:Name="PerfGrid">
                <!-- CPU -->
                <Border x:Name="CpuCard" Style="{StaticResource Card}">
                    <StackPanel>
                        <DockPanel>
                            <TextBlock Text="CPU" Style="{StaticResource CardTitle}" DockPanel.Dock="Left" />
                            <TextBlock Text="{Binding CpuTempText, Mode=OneWay}" DockPanel.Dock="Right"
                                       Style="{StaticResource TempChip}" HorizontalAlignment="Right"
                                       Foreground="{Binding CpuTempBrush, Mode=OneWay}"
                                       VerticalAlignment="Center" />
                        </DockPanel>
                        <TextBlock Text="{Binding CpuName, Mode=OneWay}" FontSize="10.5" Margin="0,6,0,0"
                                   Foreground="{StaticResource TextFaint}" TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding CpuName, Mode=OneWay}" />

                        <DockPanel Margin="0,10,0,0">
                            <TextBlock Text="{Binding CpuUsageText, Mode=OneWay}" Style="{StaticResource BigNum}"
                                       DockPanel.Dock="Left" VerticalAlignment="Center" MinWidth="78" />
                            <StackPanel VerticalAlignment="Center">
                                <ProgressBar Template="{StaticResource SlimBar}" Maximum="100"
                                             Value="{Binding CpuUsage, Mode=OneWay}" />
                                <TextBlock Style="{StaticResource FootText}" Margin="0,5,0,0"
                                           Text="{Binding CpuFooter, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </DockPanel>

                        <Border Style="{StaticResource ChartBox}">
                            <Canvas x:Name="CpuCanvas" ClipToBounds="True">
                                <Path x:Name="CpuFill" Fill="#266E7BF2" />
                                <Polyline x:Name="CpuLine" Stroke="#8A96F5" StrokeThickness="1.5"
                                          StrokeLineJoin="Round" StrokeStartLineCap="Round" />
                            </Canvas>
                        </Border>
                        <Canvas x:Name="CoreCanvas" Height="30" ClipToBounds="True" Margin="0,8,0,0" />
                        <DockPanel>
                            <TextBlock Style="{StaticResource FootText}" DockPanel.Dock="Left">
                                <Run Text="整体占用 · " /><Run Text="{Binding ChartSpanText, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock DockPanel.Dock="Right" Style="{StaticResource TempChip}"
                                       HorizontalAlignment="Right" Margin="0,7,0,0"
                                       Text="{Binding CpuLiveText, Mode=OneWay}" />
                        </DockPanel>
                    </StackPanel>
                </Border>

                <!-- 内存 -->
                <Border x:Name="MemCard" Style="{StaticResource Card}">
                    <StackPanel>
                        <DockPanel>
                            <TextBlock Text="内存" Style="{StaticResource CardTitle}" DockPanel.Dock="Left" />
                            <TextBlock Text="{Binding MemUsedText, Mode=OneWay}" DockPanel.Dock="Right"
                                       Style="{StaticResource TempChip}" HorizontalAlignment="Right"
                                       VerticalAlignment="Center" />
                        </DockPanel>
                        <TextBlock Text="{Binding MemPctText, Mode=OneWay}" Style="{StaticResource BigNum}"
                                   Margin="0,8,0,0" />

                        <Border Style="{StaticResource ChartBox}">
                            <Grid>
                                <Canvas x:Name="MemCanvas" ClipToBounds="True">
                                    <Path x:Name="MemFill" Fill="#26D9A441" />
                                    <Polyline x:Name="MemLine" Stroke="{StaticResource AccentBrush}" StrokeThickness="1.5"
                                              StrokeLineJoin="Round" StrokeStartLineCap="Round" />
                                </Canvas>
                            </Grid>
                        </Border>
                        <TextBlock Style="{StaticResource FootText}">
                            <Run Text="物理内存占用 · " /><Run Text="{Binding ChartSpanText, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock Style="{StaticResource FootText}" Text="{Binding MemCommitText, Mode=OneWay}" />
                        <TextBlock Style="{StaticResource FootText}" Text="{Binding MemSpecText, Mode=OneWay}"
                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding MemSpecText, Mode=OneWay}" />
                    </StackPanel>
                </Border>

                <!-- 显卡 -->
                <Border x:Name="GpuCard" Style="{StaticResource Card}">
                    <StackPanel>
                        <DockPanel>
                            <TextBlock Text="显卡" Style="{StaticResource CardTitle}" DockPanel.Dock="Left" />
                            <TextBlock Text="{Binding GpuTempText, Mode=OneWay}" DockPanel.Dock="Right"
                                       Style="{StaticResource TempChip}" HorizontalAlignment="Right"
                                       VerticalAlignment="Center" />
                        </DockPanel>
                        <TextBlock Text="{Binding GpuNamesText, Mode=OneWay}" FontSize="11" Margin="0,6,0,0"
                                   Foreground="{StaticResource TextSecondary}" TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding GpuNamesText, Mode=OneWay}" />

                        <DockPanel Margin="0,10,0,0">
                            <TextBlock Text="{Binding GpuUsageText, Mode=OneWay}" Style="{StaticResource BigNum}"
                                       DockPanel.Dock="Left" VerticalAlignment="Center" MinWidth="78" />
                            <StackPanel VerticalAlignment="Center">
                                <ProgressBar Template="{StaticResource SlimBar}" Maximum="100"
                                             Value="{Binding GpuUsage, Mode=OneWay}" />
                                <TextBlock Style="{StaticResource FootText}" Margin="0,5,0,0"
                                           Text="{Binding GpuMemText, Mode=OneWay}" />
                            </StackPanel>
                        </DockPanel>

                        <Border Style="{StaticResource ChartBox}">
                            <Grid>
                                <Canvas x:Name="GpuCanvas" ClipToBounds="True">
                                    <Path x:Name="GpuFill" Fill="#266CCB5F" />
                                    <Polyline x:Name="GpuLine" Stroke="#7ED673" StrokeThickness="1.5"
                                              StrokeLineJoin="Round" StrokeStartLineCap="Round" />
                                </Canvas>
                                <!-- 非 NVIDIA 显卡的空状态提示 -->
                                <TextBlock x:Name="GpuPlaceholder" Text="实时数据需 NVIDIA 显卡（NVML）"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           FontFamily="{StaticResource MonoFont}" FontSize="10"
                                           Foreground="{StaticResource TextFaint}" Visibility="Collapsed" />
                            </Grid>
                        </Border>
                        <TextBlock Style="{StaticResource FootText}" Text="{Binding GpuHintText, Mode=OneWay}" />
                        <TextBlock Style="{StaticResource FootText}" Text="{Binding GpuDriverText, Mode=OneWay}"
                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding GpuDriverText, Mode=OneWay}" />
                    </StackPanel>
                </Border>

                <!-- 网络流量 -->
                <Border x:Name="NetCard" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="网络流量" Style="{StaticResource CardTitle}" />
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <TextBlock FontFamily="{StaticResource MonoFont}" FontSize="19" FontWeight="Bold"
                                       Foreground="{StaticResource SuccessBrush}">
                                <Run Text="↓ " /><Run Text="{Binding NetDownText, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock FontFamily="{StaticResource MonoFont}" FontSize="19" FontWeight="Bold"
                                       Foreground="{StaticResource AccentBrush}" Margin="14,0,0,0">
                                <Run Text="↑ " /><Run Text="{Binding NetUpText, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>

                        <Border Style="{StaticResource ChartBox}">
                            <Canvas x:Name="NetCanvas" ClipToBounds="True">
                                <Path x:Name="NetFillDown" Fill="#266CCB5F" />
                                <Polyline x:Name="NetLineDown" Stroke="#7ED673" StrokeThickness="1.5"
                                          StrokeLineJoin="Round" StrokeStartLineCap="Round" />
                                <Polyline x:Name="NetLineUp" Stroke="#D9A441" StrokeThickness="1.2"
                                          StrokeLineJoin="Round" StrokeStartLineCap="Round" />
                            </Canvas>
                        </Border>
                        <TextBlock Style="{StaticResource FootText}">
                            <Run Text="下行面积 · 上行曲线 · " /><Run Text="{Binding ChartSpanText, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock Style="{StaticResource FootText}" Text="{Binding NetTotalText, Mode=OneWay}"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ══════════ 分区 2 · 显示与网络 ══════════ -->
            <DockPanel Margin="2,10,0,10">
                <Border Width="3" Height="11" CornerRadius="1.5" Background="{StaticResource AccentBrush}"
                        VerticalAlignment="Center" DockPanel.Dock="Left" />
                <TextBlock Text="显示与网络" FontSize="11.5" FontWeight="SemiBold"
                           FontFamily="{StaticResource DisplayFont}" Foreground="{StaticResource TextSecondary}"
                           VerticalAlignment="Center" Margin="8,0,0,0" DockPanel.Dock="Left" />
                <Border Height="1" Background="#16FFFFFF" VerticalAlignment="Center" Margin="12,0,4,0" />
            </DockPanel>

            <!-- 行 3：显示器 / 网络设备 -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- 显示器：型号 · 尺寸 · 接口 · 当前分辨率 -->
                <Border Grid.Column="0" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="显示器" Style="{StaticResource CardTitle}" Margin="0,0,0,10" />
                        <ItemsControl ItemsSource="{Binding Monitors, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,3">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding TagText, Mode=OneWay}"
                                                       FontFamily="{StaticResource MonoFont}" FontSize="10"
                                                       Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" />
                                            <StackPanel Orientation="Horizontal">
                                                <!-- 主屏徽标 -->
                                                <Border x:Name="badge" CornerRadius="3" Padding="5,1" Margin="0,0,6,0"
                                                        Background="#33D9A441" Visibility="Collapsed" VerticalAlignment="Center">
                                                    <TextBlock Text="主" FontSize="9" FontWeight="Bold"
                                                               FontFamily="{StaticResource MonoFont}"
                                                               Foreground="{StaticResource AccentBrush}" />
                                                </Border>
                                                <TextBlock Text="{Binding Name, Mode=OneWay}" FontSize="11.5" FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextPrimary}" TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding Name, Mode=OneWay}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </DockPanel>
                                        <TextBlock Text="{Binding ModeText, Mode=OneWay}" FontFamily="{StaticResource MonoFont}"
                                                   FontSize="10" Foreground="{StaticResource TextFaint}" Margin="0,3,0,0"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsPrimary, Mode=OneWay}" Value="True">
                                            <Setter TargetName="badge" Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Style="{StaticResource FootText}" Text="{Binding MonitorFootText, Mode=OneWay}" />
                    </StackPanel>
                </Border>

                <!-- 网络设备：有线/无线网卡 · IP · MAC · 状态 -->
                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="网络设备" Style="{StaticResource CardTitle}" Margin="0,0,0,10" />
                        <ItemsControl ItemsSource="{Binding Nics, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,3">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding StatusText, Mode=OneWay}"
                                                       FontFamily="{StaticResource MonoFont}" FontSize="10"
                                                       Foreground="{Binding StatusBrush, Mode=OneWay}" VerticalAlignment="Center" />
                                            <StackPanel Orientation="Horizontal">
                                                <!-- 类型徽标：有线琥珀 / 无线绿 -->
                                                <Border CornerRadius="3" Padding="5,1" Margin="0,0,6,0"
                                                        Background="{Binding KindBadgeBrush, Mode=OneWay}" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding KindText, Mode=OneWay}" FontSize="9" FontWeight="Bold"
                                                               FontFamily="{StaticResource MonoFont}"
                                                               Foreground="{Binding KindBrush, Mode=OneWay}" />
                                                </Border>
                                                <TextBlock Text="{Binding Name, Mode=OneWay}" FontSize="10.5"
                                                           FontFamily="{StaticResource MonoFont}"
                                                           Foreground="{StaticResource TextSecondary}" TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding Name, Mode=OneWay}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </DockPanel>
                                        <TextBlock Text="{Binding IpText, Mode=OneWay}" FontFamily="{StaticResource MonoFont}"
                                                   FontSize="10.5" Foreground="{StaticResource TextSecondary}" Margin="0,3,0,0"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding MacText, Mode=OneWay}" FontFamily="{StaticResource MonoFont}"
                                                   FontSize="10" Foreground="{StaticResource TextFaint}" Margin="0,2,0,0" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ══════════ 分区 3 · 存储与系统 ══════════ -->
            <DockPanel Margin="2,10,0,10">
                <Border Width="3" Height="11" CornerRadius="1.5" Background="{StaticResource AccentBrush}"
                        VerticalAlignment="Center" DockPanel.Dock="Left" />
                <TextBlock Text="存储与系统" FontSize="11.5" FontWeight="SemiBold"
                           FontFamily="{StaticResource DisplayFont}" Foreground="{StaticResource TextSecondary}"
                           VerticalAlignment="Center" Margin="8,0,0,0" DockPanel.Dock="Left" />
                <Border Height="1" Background="#16FFFFFF" VerticalAlignment="Center" Margin="12,0,4,0" />
            </DockPanel>

            <!-- 行 4：磁盘 / 系统 -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- 磁盘 -->
                <Border Grid.Column="0" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="磁盘" Style="{StaticResource CardTitle}" Margin="0,0,0,10" />
                        <ItemsControl ItemsSource="{Binding Disks}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,3">
                                        <DockPanel>
                                            <TextBlock Text="{Binding Summary}" DockPanel.Dock="Right"
                                                       FontFamily="{StaticResource MonoFont}" FontSize="10"
                                                       Foreground="{StaticResource TextSecondary}"
                                                       VerticalAlignment="Center" />
                                            <TextBlock FontSize="11.5" Foreground="{StaticResource TextSecondary}"
                                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center">
                                                <Run Text="{Binding Letter, Mode=OneWay}" FontFamily="{StaticResource MonoFont}"
                                                     Foreground="{StaticResource TextPrimary}" /><Run Text=" " /><Run Text="{Binding Label, Mode=OneWay}" />
                                            </TextBlock>
                                        </DockPanel>
                                        <ProgressBar Template="{StaticResource SlimBar}" Maximum="100"
                                                     Value="{Binding UsedPct, Mode=OneWay}" Margin="0,4,0,2" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Style="{StaticResource FootText}" Text="{Binding DiskTempsText, Mode=OneWay}"
                                   Foreground="{Binding DiskTempBrush, Mode=OneWay}"
                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding DiskTempsText, Mode=OneWay}" />
                    </StackPanel>
                </Border>

                <!-- 系统 -->
                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <StackPanel>
                        <DockPanel>
                            <TextBlock Text="系统" Style="{StaticResource CardTitle}" Margin="0,0,0,8" DockPanel.Dock="Left" />
                            <Button x:Name="CopyReportBtn" Content="复制报告" Style="{StaticResource ChipButton}"
                                    DockPanel.Dock="Right" HorizontalAlignment="Right" Margin="0,0,0,4"
                                    Click="CopyReport_Click" />
                        </DockPanel>
                        <TextBlock Text="{Binding OsText, Mode=OneWay}" FontSize="12.5"
                                   Foreground="{StaticResource TextSecondary}" Margin="0,0,0,6" />
                        <TextBlock Text="{Binding BoardBiosText, Mode=OneWay}" Style="{StaticResource FootText}"
                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding BoardBiosText, Mode=OneWay}" />
                        <TextBlock FontFamily="{StaticResource MonoFont}" FontSize="10.5"
                                   Foreground="{StaticResource TextFaint}">
                            <Run Text="{Binding UptimeText, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding SysStatsText, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock Style="{StaticResource FootText}" Text="{Binding OsInstallText, Mode=OneWay}" />
                    </StackPanel>
                </Border>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</UserControl>
