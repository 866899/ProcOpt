<Window x:Class="ProcOpt.Views.AffinityWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置 CPU 相关性"
        Width="600" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBase}"
        Foreground="{StaticResource TextPrimary}"
        FontFamily="{StaticResource MainFont}">
    <Window.Resources>
        <Style x:Key="CoreChip" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="bd" Background="{StaticResource InputBg}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1.5"
                                CornerRadius="7" Padding="12,7" MinWidth="42">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#14FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter Property="Foreground" Value="#FF151313" />
                                <Setter Property="FontWeight" Value="Bold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <StackPanel Margin="22">
        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
            <TextBlock Text="&#xE950;" FontFamily="{StaticResource IconFont}" FontSize="15"
                       Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
            <TextBlock Text="CPU 相关性" FontSize="15" FontWeight="SemiBold" Margin="9,0,0,0"
                       FontFamily="{StaticResource DisplayFont}" VerticalAlignment="Center" />
        </StackPanel>
        <TextBlock Text="勾选允许该进程使用的逻辑处理器" Foreground="{StaticResource TextSecondary}"
                   FontSize="12" Margin="0,0,0,12" />

        <WrapPanel Margin="0,0,0,12">
            <Button Content="全部" Click="All_Click" Margin="0,0,8,0" />
            <Button x:Name="BtnPOnly" Content="仅 P 核（性能）" Click="POnly_Click" Margin="0,0,8,0" />
            <Button x:Name="BtnEOnly" Content="仅 E 核（效率）" Click="EOnly_Click" Margin="0,0,8,0"
                    Visibility="Collapsed" />
        </WrapPanel>

        <Border Style="{StaticResource Card}" Padding="14,12">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="2,0,0,7">
                    <Ellipse Width="7" Height="7" Fill="{StaticResource PCoreBrush}" VerticalAlignment="Center" />
                    <TextBlock x:Name="PGroup" Text="P 核 · 性能核心" FontSize="12"
                               Foreground="{StaticResource PCoreBrush}" Margin="8,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <WrapPanel x:Name="PPanel" />
                <StackPanel x:Name="EGroupPanel" Orientation="Horizontal" Margin="2,12,0,7" Visibility="Collapsed">
                    <Ellipse Width="7" Height="7" Fill="{StaticResource ECoreBrush}" VerticalAlignment="Center" />
                    <TextBlock x:Name="EGroup" Text="E 核 · 效率核心" FontSize="12"
                               Foreground="{StaticResource ECoreBrush}" Margin="8,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <WrapPanel x:Name="EPanel" />
            </StackPanel>
        </Border>

        <TextBlock x:Name="MaskText" Margin="2,10,0,0" FontFamily="{StaticResource MonoFont}" FontSize="12"
                   Foreground="{StaticResource TextSecondary}" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="取消" Click="Cancel_Click" Width="88" />
            <Button Content="确定" Style="{StaticResource AccentButton}" Click="Ok_Click" Width="88" Margin="10,0,0,0" />
        </StackPanel>
    </StackPanel>
</Window>
